graph TB
    subgraph Users["👥 Users"]
        U1[Mobile Wallet]
        U2[Web Console]
        U3[CLI / pq-signer]
    end

    subgraph Calibre["⚡ CALIBRE LAYER-1"]
        subgraph Consensus["Consensus Layer"]
            AURA[Aura<br/>Block Production<br/>6s slots]
            GRANDPA[GRANDPA<br/>Finality<br/>~12s]
        end

        subgraph Execution["Q-UTXO Execution Layer"]
            MEMPOOL[Fast-Path<br/>Mempool<br/>Conflict Detector]
            PALLET[pallet-qutxo<br/>State Machine]
            SET[(UtxoSet<br/>RocksDB)]
        end

        subgraph Crypto["Post-Quantum Crypto Layer"]
            AEGIS[A.E.G.I.S.<br/>ML-DSA-44<br/>Verification]
            QR_CKD[QR-CKD<br/>Context Derivation]
        end
    end

    subgraph Interop["🌉 Interoperability"]
        SOLVERS[Solver Network]
        ZK[ZK Intent Bridge<br/>roadmap]
        ETH[Ethereum / L2s]
    end

    U1 & U2 & U3 -->|RPC :9944| MEMPOOL
    MEMPOOL --> PALLET
    PALLET <--> SET
    PALLET --> AEGIS
    PALLET --> QR_CKD
    AURA --> PALLET
    PALLET --> GRANDPA
    SOLVERS -.->|Intent settlement| ZK
    ZK -.->|Proof of source tx| ETH

